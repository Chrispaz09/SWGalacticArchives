@using SWGalacticArchives.Models
@typeparam T
@inject NavigationManager Navigation
<h3>@DataGridName DataGrid</h3>

<Table TItem="Result<T>" 
       IsStriped="true" 
       HeaderStyle="TableHeaderStyle.Dark"
       Items="AllItems"
       PageItems="AllItems.Count()"
       ShowFooter="true">
           <TableColumns>
                <TableColumn @bind-Field="@context.Uid" />
                <TableColumn @bind-Field="@context.name" />
                <TableColumn @bind-Field="@context.Uid" Text="Details">
                    <Template Context="value">
                        <Button Color="Color.Warning" Text="View Details" Size="Size.ExtraSmall" @onclick="@(() => GoToViewDetails(value.Value))" />
                    </Template>
                </TableColumn>
           </TableColumns>
</Table>

@if (DataGridInfo.previous is not null)
{
    <button class="btn btn-primary" @onclick="(() => GetPreviousItems())">Previous Page</button>
}
@if (DataGridInfo.next is not null)
{
    <button class="btn btn-primary" @onclick="(() => GetNextItems())">Next Page</button>
}

<Footer style="color: white;">
    Total Records: @DataGridInfo.total_records
</Footer>